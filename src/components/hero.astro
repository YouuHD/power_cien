---
import Button from "../components/button.astro";

interface Props {
  variant?: "light" | "light-accent" | "dark" | "dark-accent" | "navy";
  image?: string;
}

const {
  variant = "light",
  image = "public/img/hero.jpg",
} = Astro.props;

const variants = {
  light: {
    overlay: "bg-white/70",
    title: "text-[#111827]",
    text: "text-zinc-700",
    accent: "text-[#111827]",
    button: "primary",
    icon: "text-zinc-600",
  },
  "light-accent": {
    overlay: "bg-white/65",
    title: "text-[#111827]",
    text: "text-zinc-700",
    accent: "text-[#F5EC02]",
    button: "secondary",
    icon: "text-zinc-600",
  },
  dark: {
    overlay: "bg-black/55",
    title: "text-white",
    text: "text-zinc-200",
    accent: "text-[#F5EC02]",
    button: "secondary",
    icon: "text-zinc-300",
  },
  "dark-accent": {
    overlay: "bg-black/65",
    title: "text-white",
    text: "text-zinc-200",
    accent: "text-(--secondary)",
    button: "secondary",
    icon: "text-zinc-300",
  },
  navy: {
    overlay: "bg-[#0F2748]/70",
    title: "text-white",
    text: "text-blue-100",
    accent: "text-(--secondary)",
    button: "secondary",
    icon: "text-blue-100",
  },
};

const current = variants[variant];
---

<section class="relative overflow-hidden ">
  <img
    src={image}
    alt="Instalación industrial"
    class="absolute inset-0 h-full w-full object-cover"
  />

  <div class={`absolute inset-0 ${current.overlay}`}></div>

  <div class="relative z-10 mx-auto flex min-h-155 max-w-7xl items-center px-6 py-16 lg:px-10 lg:py-24">
    <div class="max-w-2xl">
      <h1 class={`text-4xl font-extrabold leading-tight md:text-5xl lg:text-6xl ${current.title}`}>
        <span class={current.accent}>Energía</span> que impulsa la industria
      </h1>

      <p class={`mt-5 text-base sm:text-lg leading-relaxed ${current.text}`}>
        Diseñamos, instalamos y mantenemos sistemas eléctricos industriales
        con altos estándares de calidad, seguridad y eficiencia.
      </p>

      <div class="mt-8 w-full sm:w-auto">
        <a href="#cotizacion" class="w-full sm:w-auto">
          <Button variant={current.button} size="large" class="w-full justify-center text-center sm:w-auto">
            Solicita una cotización
          </Button>
        </a>
      </div>

      <div class={`mt-10 flex flex-wrap items-center gap-6 text-sm ${current.icon}`}>
        <div class="flex items-center gap-2">
          <svg class="h-5 w-5 text-(--secondary)" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2l7 4v6c0 5-3.5 9-7 10-3.5-1-7-5-7-10V6l7-4z" />
          </svg>
          <span>Ingeniería de excelencia</span>
        </div>

        <div class="flex items-center gap-2">
          <svg class="h-5 w-5 text-(--secondary)" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <span>Energía con propósito</span>
        </div>

        <div class="flex items-center gap-2">
          <svg class="h-5 w-5 text-(--secondary)" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4" />
          </svg>
          <span>Resultados que trascienden</span>
        </div>
      </div>
    </div>
  </div>
</section>