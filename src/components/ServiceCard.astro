---
// src/components/ServiceCard.astro

interface Props {
  title: string;
  description: string;
  iconSvg: string;
}

const { title, description, iconSvg } = Astro.props;
---

<article class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100 transition-all duration-300 hover:shadow-md">
  <!-- Contenedor del Icono -->
  <div class="w-20 h-20 mb-4 text-amber-400">
    <svg 
      xmlns="http://www.w3.org/2000/svg" 
      fill="none" 
      viewBox="0 0 24 24" 
      stroke-width="1.5" 
      stroke="currentColor" 
      class="w-full h-full"
    >
      <Fragment set:html={iconSvg} />
    </svg>
  </div>

  <!-- Contenido -->
  <h3 class="text-lg font-bold text-slate-900 tracking-wide mb-2 uppercase">
    {title}
  </h3>
  <p class="text-slate-500 leading-relaxed text-sm">
    {description}
  </p>
</article>