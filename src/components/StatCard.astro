---
interface Props {
  title?: string;
  description?: string;
  variant?: "light" | "accent" | "outline" | "dark" | "ghost";
  size?: "small" | "medium" | "large";
  class?: string;
}

const {
  title = "0+",
  description = "Métrica",
  variant = "dark",
  size = "medium",
  class: className = "",
} = Astro.props;

// Estilos por variante de color
const variants = {
  dark: "bg-zinc-900/90 text-white border-zinc-800",
  light: "bg-white text-zinc-900 border-zinc-200 shadow-sm",
  accent: "bg-zinc-900/90 text-yellow-400 border-yellow-400/30",
  outline: "bg-transparent text-white border-zinc-700/80",
  ghost: "bg-transparent text-white border-transparent",
};

// Escalas tipográficas y paddings fluidos
const sizeStyles = {
  small: {
    padding: "p-4 sm:p-5",
    value: "text-2xl sm:text-3xl",
    label: "text-xs sm:text-sm",
  },
  medium: {
    padding: "p-5 sm:p-6",
    value: "text-3xl sm:text-4xl lg:text-5xl",
    label: "text-xs sm:text-sm md:text-base",
  },
  large: {
    padding: "p-6 sm:p-8",
    value: "text-4xl sm:text-5xl lg:text-6xl",
    label: "text-sm sm:text-base md:text-lg",
  },
};

const currentSize = sizeStyles[size];
---

<article
  class={`flex flex-col justify-center border transition-all duration-200 ${variants[variant]} ${currentSize.padding} ${className}`}
>
  <h3 class={`font-extrabold tracking-tight leading-none ${currentSize.value}`}>
    {title}
  </h3>
  <p class={`mt-2 font-medium leading-snug text-zinc-400 ${currentSize.label}`}>
    {description}
  </p>
</article>