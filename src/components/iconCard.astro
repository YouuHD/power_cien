---
import Modal from './modal.astro';
interface Props {
  title?: string;
  description_simple?: string;
  description?: string;
  variant?: "light" | "accent" | "outline" | "dark" | "ghost";
  size?: "small" | "medium" | "large";
  imageSrc?: string;
  id?: string;
}

const {
  title = "Título del Proyecto",
  description_simple = "Descripción breve del proyecto...",
  description = "Descripción detallada del proyecto...",
  variant = "dark",
  imageSrc = "public/img/maquina.jpeg",
  id = `project-card-${Math.random().toString(36).substring(2, 9)}`
} = Astro.props;
---

<article class={`feature-card feature-card-${variant}`}>
  <div class="feature-card__icon">
    <svg class="h-6 w-6 fill-current" viewBox="0 0 24 24">
      <path d="M13 2L3 14h8l-1 8 11-13h-8l1-7z" />
    </svg>
  </div>
  <h3 class="feature-card__title">{title}</h3>
  <p class="feature-card__description">{description_simple}</p>

  <Modal id={id} title={title} description={description} imageSrc={imageSrc} />
</article>

