---
interface Props {
  badge?: string;
  title: string;
  description?: string;
  theme?: "dark" | "light";
  class?: string;
}

const {
  badge,
  title,
  description,
  theme = "dark",
  class: className = "",
} = Astro.props;

const isDark = theme === "dark";
---

<section id={badge}
  class={`w-full py-16 px-6 md:px-12 transition-colors ${
    isDark ? "bg-[#121214] text-white" : "bg-zinc-50 text-zinc-900"
  } ${className}`}
>
  <div class="mx-auto max-w-6xl">
    <!-- Header de la sección -->
    <div class="mb-12 max-w-2xl">
      {
        badge && (
          <span class="text-sm font-semibold tracking-wider text-zinc-400">
            {badge}
          </span>
        )
      }
      <h2 class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">
        {title}
      </h2>
      {
        description && (
          <p class={`mt-3 text-base ${isDark ? "text-zinc-400" : "text-zinc-600"}`}>
            {description}
          </p>
        )
      }
    </div>

    <!-- Grid de cards -->
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <slot />
    </div>
  </div>
</section>