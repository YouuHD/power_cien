---
interface Props {
  id: string;
  title: string;
  description: string;
  imageSrc: string;
}

const { id, title, description, imageSrc } = Astro.props;

---

<div>
    <footer class="feature-card__footer">
        <button type="button" data-open-modal={id} class="open-btn hover:text-[#0F2748]/70 cursor-pointer">
          Más información
        </button>
    </footer>

    <!-- Modal -->
    <dialog id={id} class="responsive-dialog">
        <div class="dialog-content">
        <header class="dialog-header">
            <h4>{title}</h4>
            <button type="button" data-close-modal={id} class="close-btn" aria-label="Cerrar">&times;</button>
        </header>
        
        <div class="dialog-body">
            <div class="dialog-image">
            <img src={imageSrc} alt={title} loading="lazy" />
            </div>
            <div class="dialog-text">
            <p>{description}</p>
            </div>
        </div>
        </div>
    </dialog>
</div>

<script>
  // Control de apertura y cierre mediante eventos
  document.querySelectorAll('[data-open-modal]').forEach((button) => {
    button.addEventListener('click', () => {
      const modalId = button.getAttribute('data-open-modal');
      if (!modalId) return;
      const dialog = document.getElementById(modalId) as HTMLDialogElement | null;
      dialog?.showModal();
    });
  });

  document.querySelectorAll('[data-close-modal]').forEach((button) => {
    button.addEventListener('click', () => {
      const modalId = button.getAttribute('data-close-modal');
      if (!modalId) return;
      const dialog = document.getElementById(modalId) as HTMLDialogElement | null;
      dialog?.close();
    });
  });

  // Cerrar al hacer clic en el backdrop
  document.querySelectorAll('dialog.responsive-dialog').forEach((dialog) => {
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) {
        (dialog as HTMLDialogElement).close();
      }
    });
  });
</script>

<style>
  /* Estilos del Backdrop */
  .responsive-dialog::backdrop {
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
  }

  /* Reset del dialog */
  .responsive-dialog {
    border: none;
    padding: 0;
    background: transparent;
    color: inherit;
    max-width: 100vw;
    margin: auto;
  }

  .dialog-content {
    background-color: #18181b; /* Cambia al fondo de tu diseño dark/light */
    color: #f4f4f5;
    border: 1px solid #27272a;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);
  }

  .dialog-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid #27272a;
  }

  .dialog-header h4 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .close-btn {
    background: transparent;
    border: none;
    color: #a1a1aa;
    font-size: 1.5rem;
    cursor: pointer;
    line-height: 1;
  }

  .close-btn:hover {
    color: #ffffff;
  }

  .dialog-body {
    padding: 1.5rem;
    display: grid;
    gap: 1.5rem;
  }

  .dialog-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0.5rem;
  }

  /* === MÓVIL: (Sheet) === */
  @media (max-width: 767px) {
    .responsive-dialog {
      position: fixed;
      inset: auto 0 0 0; /* Anclado al borde inferior */
      width: 100%;
      max-height: 85vh;
      border-radius: 1rem 1rem 0 0;
      overflow-y: auto;
      animation: slide-up 0.25s ease-out;
    }

    .dialog-content {
      border-radius: 1rem 1rem 0 0;
      min-height: 300px;
    }

    .dialog-body {
      grid-template-columns: 1fr;
    }

    @keyframes slide-up {
      from { transform: translateY(100%); }
      to { transform: translateY(0); }
    }
  }

  /* === DESKTOP: Modal centrado === */
  @media (min-width: 768px) {
    .responsive-dialog {
      width: 90%;
      max-width: 680px;
      border-radius: 0.75rem;
      animation: fade-in 0.2s ease-out;
    }

    .dialog-content {
      border-radius: 0.75rem;
    }

    .dialog-body {
      grid-template-columns: 1fr 1fr; /* Imagen izquierda, texto derecha */
      align-items: center;
    }

    @keyframes fade-in {
      from { opacity: 0; transform: scale(0.95); }
      to { opacity: 1; transform: scale(1); }
    }
  }
</style>