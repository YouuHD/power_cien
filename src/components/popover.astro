---
interface Props {
    title: string;
    image: string;
    description: string;
}

const {
    title,
    image,
    description
} = Astro.props;
---

<div class="relative group">
    <!-- Trigger -->
    <div class="flex items-center gap-3 cursor-pointer">
        <div
            class="flex h-8 w-8 items-center justify-center
                   rounded-md border border-zinc-700
                   bg-zinc-800 text-white"
        >
            <svg
                class="h-3.5 w-3.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="3"
            >
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
        </div>
        <slot/>
        <!-- <span class="font-semibold text-white">
            {title}
        </span> -->
    </div>

    <!-- Popover -->
    <div
        class="absolute z-50
        top-full left-1/2
        mt-3
        w-[min(300px,calc(100vw-2rem))]
        -translate-x-1/2

        lg:top-1/2
        lg:left-full
        lg:mt-0
        lg:ml-2
        lg:-translate-y-1/2
        lg:translate-x-0

        invisible opacity-0
        group-hover:visible
        group-hover:opacity-100
        pointer-events-none

        transition-opacity duration-150"
    >
        <article
            class="overflow-hidden rounded-xl
                   border border-zinc-800
                   bg-[#18181b]
                   shadow-2xl"
        >
            <div class="p-5">

                <h3 class="mb-4 text-lg font-bold text-white">
                    {title}
                </h3>

                <img
                    src={image}
                    alt={title}
                    class="mb-4 w-full rounded-lg"
                />

                <p class="text-sm leading-6 text-zinc-300">
                    {description}
                </p>

            </div>
        </article>
    </div>
</div>